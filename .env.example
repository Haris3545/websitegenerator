# Copy this file to .env.local and fill in your own values. Nothing here
# should ever be shared between deployments/operators — every key below is
# tied to whichever account created it, so a new operator picking up this
# codebase needs to generate their own for every line, not reuse someone
# else's.

# --- Supabase (required) ---
# Create a project at supabase.com, then Project Settings > API for these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (required) ---
# Free key, no billing required: aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults to 900/day if unset (stays under the free tier's
# 1,000/day cap with some margin).
GEMINI_DAILY_LIMIT=

# --- Optional third-party API keys ---
# Each of these unlocks one specific feature; the rest of the app works
# fine without any of them (the affected tab just shows a message naming
# which key it needs). Get each from its own provider, under whichever
# account should own that feature's usage/billing going forward.
YOUTUBE_API_KEY=
LASTFM_API_KEY=
TICKETMASTER_API_KEY=
NEWSAPI_KEY=
GENIUS_ACCESS_TOKEN=
SERPAPI_KEY=
GIPHY_API_KEY=
GOOGLE_FONTS_API_KEY=

# --- Cron (optional but recommended) ---
# Any random string — generate with `openssl rand -hex 32`. Vercel Cron
# automatically sends this as a bearer token when it's set both here and in
# your Vercel project's env vars, so the twice-daily refresh endpoint
# (vercel.json) can't be triggered by anyone else who finds the URL.
CRON_SECRET=

# --- Publishing a standalone site per artist (optional) ---
# Only needed to use the builder's "Publish" button, which generates each
# artist their own standalone GitHub repo + Vercel project. All four of
# these must point at the SAME GitHub account/org — the one hosting this
# very codebase.
#
# GITHUB_ACCESS_TOKEN: a Personal Access Token (classic: "repo" +
#   "delete_repo" scopes; fine-grained: Contents read/write + Administration
#   read/write on the template repo) from that account —
#   github.com/settings/tokens.
# VERCEL_API_TOKEN: from that account/team's Vercel dashboard —
#   vercel.com/account/tokens.
# GITHUB_TEMPLATE_OWNER / GITHUB_TEMPLATE_REPO: the GitHub username/org and
#   repo name this codebase itself lives at (e.g. if you've pushed this to
#   github.com/your-org/your-repo, that's "your-org" and "your-repo"). That
#   repo needs "Template repository" checked in its Settings > General.
GITHUB_ACCESS_TOKEN=
VERCEL_API_TOKEN=
GITHUB_TEMPLATE_OWNER=
GITHUB_TEMPLATE_REPO=

# --- Standalone per-artist deployments only ---
# Never set this on the main multi-tenant deployment — publishArtistSite
# sets it automatically on each artist's own generated Vercel project, to
# lock that deployment to just the one artist and disable in-place editing.
PINNED_ARTIST_SLUG=
